---
const description = "404";
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
const pageTitle = "Uh-oh!";
---
<Layout pageTitle={pageTitle}>
    <div class="lost">
        <div class="gif">
            <img src="/images/gato_jan1.webp" role="presentation" width="300" height="300" decoding="async">
        </div>
        <h1 class="lost__header">{ description }</h1>
        <p class="lost__body">Well, that's embarrassin'. &#128531</p>
        <p>
            <a class="lost__link" href="/">Return Home</a>
        </p>
    </div>
</Layout>

